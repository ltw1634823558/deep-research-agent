# ===== LLM 配置 =====
# 填写规则（全局通用，务必遵守）：
#   1) 一律写成 KEY=值，等号两边不要留空格；
#   2) 不要加引号（OPENAI_API_KEY=sk-xxx 即可，加 "..." 也能跑但不建议）；
#   3) sk-xxx / 你的key 都是占位符，必须整段替换成真实 key，否则会鉴权失败。
# mock=离线假模型（无需 key，用于演示/测试）；openai=OpenAI 或兼容端点（DeepSeek/通义/Ollama）
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-xxx
# base_url：仅当使用「非 OpenAI 官方」的兼容端点时才需要改：
#   OpenAI 官方 → 保持默认 https://api.openai.com/v1
#   DeepSeek   → https://api.deepseek.com/v1
#   通义千问   → https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地Ollama → http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.2

# ===== 检索工具 =====
# Tavily 搜索 key：前往官网 https://tavily.com 注册，在 https://app.tavily.com 的
# API Keys 页面创建并复制 Key 填入下面。
# 注意：只要填了 key，系统就会强制走真实 Tavily 联网；key 无效/过期会直接报错，不会静默 mock。
# 想离线 mock 跑，把下面留空即可。
TAVILY_API_KEY=

# 检索后端：tavily（直连，向后兼容）| mcp（经 MCP Server 调用 Tavily 工具）
SEARCH_PROVIDER=tavily
# 自定义 MCP Server 启动命令（空格分隔）；留空则用项目自带服务（python -m src.mcp.server）。
# 也可指向官方 Tavily MCP（需本机有 Node）：npx -y tavily-mcp
MCP_SERVER_COMMAND=

# ===== Obsidian 私域知识库 =====
# 仓库根目录绝对路径（如 D:/vault）；留空则使用内置合成仓库，离线也能跑
OBSIDIAN_VAULT_PATH=
# 研究模式：web（仅联网）| local（仅 Obsidian）| hybrid（联网 + 私域知识）
RESEARCH_MODE=web

# ===== 向量化 Embedding（RAG 召回阶段）=====
# mock=确定性哈希向量（离线可用，无需 key）；openai=OpenAI 兼容端点（DeepSeek/通义等）
# 本项目不向量化不依赖本地 ONNX 模型，Chroma 也不会自动下载 all-MiniLM-L6-v2，即装即跑。
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=           # OpenAI 默认留空；兼容端点填对应 base_url
EMBEDDING_MODEL=text-embedding-3-small

# ===== 重排 Rerank（RAG 精排阶段）=====
# mock=语义余弦+词面重叠（离线可用）；cohere=Cohere Rerank API（需 COHERE_API_KEY）
RERANK_PROVIDER=mock
COHERE_API_KEY=
# 每轮 researcher 对候选来源做向量召回 + 重排后返回的条数
RAG_TOP_K=4
# RAG 向量库后端：auto（默认，优先 Chroma，离线自动降级内存）| chroma（强制）| memory（纯内存，离线最稳）
RAG_BACKEND=auto

# ===== 长记忆（语义召回层）=====
# 开启后，每次研究结束会把报告洞察写入语义向量索引（Chroma 持久化 / 离线降级内存），
# 后续研究的 researcher 阶段做语义召回，复用历史洞察、降低重复检索。
MEMORY_ENABLED=true
# 后端：auto（默认，优先 Chroma 持久化，离线降级内存）| chroma（强制）| memory（纯内存，最稳）
MEMORY_BACKEND=auto
# Chroma 持久化目录（跨进程/重启保留历史记忆）；离线降级时此目录不创建
MEMORY_PATH=.memory_store
# SQLite 关键词召回落库（语义层无命中时的兜底）；可指向临时/持久路径
MEMORY_DB_PATH=memory.db
# 每次 researcher 语义召回的历史洞察条数
MEMORY_TOP_K=3

# ===== Analyst 真实 LLM 自愈回路 =====
# 仅当 LLM_PROVIDER=openai 时生效：分析产出后经「自我批判-修复」循环修订，最多尝试次数
ANALYST_SELF_HEAL=2
# 批判方式：heuristic（确定性启发式，离线可用）| llm（额外 LLM 批判）
ANALYST_CRITIC=heuristic

# ===== 可观测（LangFuse）=====
# 去哪拿 key（免费，3 步）：
#   1) 打开 https://cloud.langfuse.com 注册/登录
#   2) 新建一个 Project（项目）
#   3) 进项目 → Settings → API Keys，会看到 pk-lf-...（Public）和 sk-lf-...（Secret）
# 把 pk-lf-... 填到 LANGFUSE_PUBLIC_KEY，sk-lf-... 填到 LANGFUSE_SECRET_KEY；
# LANGFUSE_HOST 默认 https://cloud.langfuse.com 不用改（自建/欧盟区才改）。
# 两个 key 留空 = 关闭可观测，不影响研究运行。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 评估指标（任务完成率/引用准确率/幻觉率）会在配置 LangFuse 后自动以 score 写入 trace

# ===== 流程参数 =====
MAX_RESEARCH_ITERATIONS=3
RESEARCH_WINDOW=10
